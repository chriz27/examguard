<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (Wajib untuk Geolocation, Kamera, Mikrofon, dan Secure Cookies)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. SPA Routing Fallback ke index.html (Mencegah error 404 saat refresh di cPanel)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# 3. Header Keamanan & Permissions-Policy
<IfModule mod_headers.c>
  # Izinkan Geolocation, Kamera, Mikrofon, Fullscreen untuk domain sendiri
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(self), fullscreen=(self), clipboard-read=(self), clipboard-write=(self)"
  
  # Mencegah MIME sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Proteksi clickjacking untuk iframe umum (namun iframe internal tetap jalan)
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Mencegah XSS attack pada browser lama
  Header set X-XSS-Protection "1; mode=block"

  # Cache-Control untuk index.html agar perubahan rilis langsung dideteksi siswa
  <FilesMatch "index\.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache jangka panjang untuk aset ter-hash
  <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# 4. Gzip & Brotli Compression untuk performa cepat di hosting cPanel
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

