{
  "name": "examguard",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "homepage": "https://github.com/chriz27/examguard",
  "repository": {
    "type": "git",
    "url": "https://github.com/chriz27/examguard.git"
  },
  "scripts": {
    "dev": "node --experimental-sqlite ./node_modules/vite/bin/vite.js --host",
    "start": "node --experimental-sqlite server/production.cjs",
    "build": "vite build",
    "preview": "node --experimental-sqlite ./node_modules/vite/bin/vite.js preview --host",
    "test:db": "node --experimental-sqlite server/test-db.cjs",
    "db:reset": "node -e \"const fs=require('fs'); ['examguard.db','examguard.db-shm','examguard.db-wal','.examguard-migrated'].forEach(f=>{try{fs.unlinkSync(f);console.log('Deleted: '+f);}catch{}}); console.log('Database reset selesai. Restart npm run dev.');\"",
    "db:migrate": "node --experimental-sqlite -e \"const {dbApi}=require('./server/db.cjs'); const r=dbApi.migrateFromJsonFile('.examguard-db.json'); console.log(r.success?'Migrasi berhasil!':'Gagal: '+r.message);\""
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "vite": "^6.2.0",
    "ws": "^8.23.0"
  }
}